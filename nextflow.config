params {
    genome = "hg38"
}

/*
 * Reuse the exact shared environment/configuration used by germlineNGS.
 * This supplies genome_fasta, genome_version, Singularity paths,
 * GATK image, tmp settings and the sambamvcftools conda environment.
 */
def sharedConfig = new File('/data/configs/nextflowNGS.config')
if (sharedConfig.exists()) {
    includeConfig sharedConfig
}
